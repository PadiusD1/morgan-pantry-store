# Morgan State FRC - current PostgreSQL application
# Copy to a local .env only for an independently provisioned development setup.
# The isolated scripts/local-stack/start.sh generates its own environment.
# Never commit real credentials. Configure production secrets in Vercel instead.

# Required for database access. Production uses the configured Supabase pooler.
# Example for the synthetic local stack only:
# DATABASE_URL=postgres://frc@localhost:55418/frc_stack
DATABASE_URL=

# Required for login/session signing. Generate a random secret, at least 32 chars.
# For example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Keep true for production HTTPS. Set false ONLY for local HTTP development.
COOKIE_SECURE=true

# Local Node server (Vercel manages its own listener).
PORT=5000
FRC_LISTEN_HOST=127.0.0.1

# Optional comma-separated allowed browser origins; same-origin needs none.
ALLOWED_ORIGINS=

# Existing distributed login/signup rate limiter. Configure both in production
# when using Upstash. Without it the fallback is only per server instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional barcode providers; leave unset when not configured.
UPCITEMDB_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
USDA_API_KEY=

# Optional PostgreSQL certificate verification hardening. Validate the configured
# provider CA before enabling; do not break a live connection without a preview.
# PGSSL_REJECT_UNAUTHORIZED=true
# PGSSL_CA=

# DB_PATH belonged to the retired SQLite runtime and is not used by this app.
